# PayPal Developer (sandbox only for development)
# https://developer.paypal.com/dashboard/applications/sandbox
# Copy this file to frontend/.env.local for local dev.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_ENVIRONMENT=sandbox

# Policy: max single payment in USD (demo default 500)
CAPSTAN_MAX_PAYMENT_USD=500

# Optional: hosted PayPal MCP (sandbox) — see docs/ARCHITECTURE.md
# PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# AI provider (server-side only — do not expose to browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=

# AG Grid / AG Studio license key if required for production build (TODO(verify) trial/dev terms)
# AG_GRID_LICENSE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: audit file directory (Vercel uses /tmp automatically when VERCEL=1)
# CAPSTAN_AUDIT_DIR=
